    <!-- About -->
    <string name="about_title">About Telefarm</string>
    <string name="about_description">Telefarm is an independent, personal Telegram client for Android. It speaks to Telegram directly through TDLib, the official Telegram Database Library, without any intermediate server.</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_text">Your phone number, verification codes and session data never leave this device. Sessions are stored in private application storage and are encrypted with a key held by the Android keystore. Telefarm does not operate a server and does not upload your chats anywhere.</string>
    <string name="about_disclaimer_title">Disclaimer</string>
    <string name="about_disclaimer_text">Telefarm is not affiliated with, endorsed by, or sponsored by Telegram. Telegram and related trademarks belong to their respective owners.</string>
    <string name="about_source_title">Source code</string>
    <string name="about_source_text">github.com/darkshot47/Telegram-Android</string>
    <string name="about_libraries">Built with TDLib, the Telegram Database Library, and AndroidX.</string>
    <string name="about_close">Close</string>

