<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/spacing_xlarge"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/spacing_large">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@null"
            android:src="@drawable/ic_telefarm_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Telefarm.ScreenTitle"
            android:textSize="26sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_tiny"
            android:text="@string/auth_welcome_subtitle"
            android:textAppearance="@style/TextAppearance.Telefarm.ItemSubtitle"
            android:textAlignment="center" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/authProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:indeterminate="true"
            android:visibility="gone"
            app:trackCornerRadius="2dp" />

        <TextView
            android:id="@+id/authError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:accessibilityLiveRegion="polite"
            android:background="@color/surface_variant"
            android:padding="@dimen/spacing_medium"
            android:textColor="@color/error"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/authStepContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:orientation="vertical">

            <include
                android:id="@+id/authPhone"
                layout="@layout/view_auth_phone" />

            <include
                android:id="@+id/authCode"
                layout="@layout/view_auth_code" />

            <include
                android:id="@+id/authPassword"
                layout="@layout/view_auth_password" />

            <include
                android:id="@+id/authEmail"
                layout="@layout/view_auth_email" />

            <include
                android:id="@+id/authOtherDevice"
                layout="@layout/view_auth_other_device" />

            <include
                android:id="@+id/authRegister"
                layout="@layout/view_auth_register" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:paddingTop="@dimen/spacing_medium"
            android:text="@string/app_local_only_note"
            android:textAppearance="@style/TextAppearance.Telefarm.Caption"
            android:textAlignment="center" />

    </LinearLayout>

</ScrollView>
