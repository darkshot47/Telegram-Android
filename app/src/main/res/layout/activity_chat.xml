<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:elevation="0dp"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/icon_tint"
        app:menu="@menu/menu_chat">

        <LinearLayout
            android:id="@+id/headerContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/avatar_small"
                android:layout_height="@dimen/avatar_small">

                <TextView
                    android:id="@+id/headerInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_circle"
                    android:gravity="center"
                    android:textColor="@color/text_on_accent"
                    android:textSize="14sp" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/headerPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/profile_photo"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Telefarm.Circle" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/headerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Telefarm.ItemTitle"
                    tools:text="Chat title" />

                <TextView
                    android:id="@+id/headerSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Telefarm.Caption"
                    android:visibility="gone"
                    tools:text="last seen recently" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.appbar.MaterialToolbar>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/selectionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_variant"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/spacing_small"
            android:paddingEnd="@dimen/spacing_small"
            android:paddingBottom="@dimen/spacing_small"
            android:visibility="gone">

            <TextView
                android:id="@+id/selectionCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Telefarm.ItemTitle" />

            <ImageView
                android:id="@+id/selectionForward"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chat_action_forward"
                android:padding="@dimen/spacing_medium"
                android:src="@drawable/ic_forward"
                app:tint="@color/icon_tint" />

            <ImageView
                android:id="@+id/selectionDelete"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chat_delete_message"
                android:padding="@dimen/spacing_medium"
                android:src="@drawable/ic_delete"
                app:tint="@color/icon_tint" />

            <ImageView
                android:id="@+id/selectionClose"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chat_selection_cancel"
                android:padding="@dimen/spacing_medium"
                android:src="@drawable/ic_close"
                app:tint="@color/icon_tint" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pinnedBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_variant"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/spacing_small"
            android:paddingEnd="@dimen/spacing_small"
            android:paddingBottom="@dimen/spacing_small"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/pinnedContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_pinned_message"
                    android:textAppearance="@style/TextAppearance.Telefarm.Caption"
                    android:textColor="@color/accent" />

                <TextView
                    android:id="@+id/pinnedText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.Telefarm.ItemSubtitle" />
            </LinearLayout>

            <ImageView
                android:id="@+id/pinnedClose"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chat_unpin_message"
                android:padding="@dimen/spacing_medium"
                android:src="@drawable/ic_close"
                app:tint="@color/icon_tint" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messageList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/spacing_small"
            android:paddingBottom="@dimen/spacing_small"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/chatStateContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/chatStateProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/chatStateTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Telefarm.ItemTitle"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chatStateMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Telefarm.ItemSubtitle"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chatStateAction"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/chat_list_retry"
                android:visibility="gone" />

        </LinearLayout>

    </FrameLayout>

    <TextView
        android:id="@+id/typingIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/spacing_tiny"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/spacing_tiny"
        android:textAppearance="@style/TextAppearance.Telefarm.Caption"
        android:visibility="gone"
        tools:text="typing..." />

        <LinearLayout
            android:id="@+id/scheduleBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_variant"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/spacing_small"
            android:paddingEnd="@dimen/spacing_small"
            android:paddingBottom="@dimen/spacing_small"
            android:visibility="gone">

            <TextView
                android:id="@+id/scheduleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Telefarm.ItemSubtitle" />

            <ImageView
                android:id="@+id/scheduleClose"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chat_schedule_cancel"
                android:padding="@dimen/spacing_medium"
                android:src="@drawable/ic_close"
                app:tint="@color/icon_tint" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/replyBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_variant"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/spacing_small"
            android:paddingEnd="@dimen/spacing_small"
            android:paddingBottom="@dimen/spacing_small"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/replySender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Telefarm.Caption"
                    android:textColor="@color/accent" />

                <TextView
                    android:id="@+id/replyPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.Telefarm.ItemSubtitle" />
            </LinearLayout>

            <ImageView
                android:id="@+id/replyClose"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chat_reply_cancel"
                android:padding="@dimen/spacing_medium"
                android:src="@drawable/ic_close"
                app:tint="@color/icon_tint" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/formatBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_variant"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_small"
                android:paddingTop="@dimen/spacing_tiny"
                android:paddingEnd="@dimen/spacing_small"
                android:paddingBottom="@dimen/spacing_tiny">

                <TextView
                    android:id="@+id/formatBold"
                    style="@style/Widget.Telefarm.FormatButton"
                    android:contentDescription="@string/chat_format_bold"
                    android:text="@string/chat_format_bold_glyph"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/formatItalic"
                    style="@style/Widget.Telefarm.FormatButton"
                    android:contentDescription="@string/chat_format_italic"
                    android:text="@string/chat_format_italic_glyph"
                    android:textStyle="italic" />

                <TextView
                    android:id="@+id/formatCode"
                    style="@style/Widget.Telefarm.FormatButton"
                    android:contentDescription="@string/chat_format_code"
                    android:fontFamily="monospace"
                    android:text="@string/chat_format_code_glyph" />

                <TextView
                    android:id="@+id/formatStrikethrough"
                    style="@style/Widget.Telefarm.FormatButton"
                    android:contentDescription="@string/chat_format_strikethrough"
                    android:text="@string/chat_format_strikethrough_glyph" />

                <TextView
                    android:id="@+id/formatSpoiler"
                    style="@style/Widget.Telefarm.FormatButton"
                    android:contentDescription="@string/chat_format_spoiler"
                    android:text="@string/chat_format_spoiler_glyph" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/recordingBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_variant"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/spacing_small"
            android:paddingEnd="@dimen/spacing_small"
            android:paddingBottom="@dimen/spacing_small"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_mic"
                app:tint="@color/error" />

            <TextView
                android:id="@+id/recordingTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Telefarm.ItemTitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/recordingCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_recording_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/recordingSend"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_recording_send" />
        </LinearLayout>

    <LinearLayout
        android:id="@+id/composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_small"
        android:paddingTop="@dimen/spacing_tiny"
        android:paddingEnd="@dimen/spacing_small"
        android:paddingBottom="@dimen/spacing_small">

        <ImageView
            android:id="@+id/attachButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_attach_file"
            android:padding="@dimen/spacing_medium"
            android:src="@drawable/ic_file"
            app:tint="@color/icon_tint" />

        <ImageView
            android:id="@+id/formatButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_marginEnd="@dimen/spacing_tiny"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_format_toggle"
            android:padding="@dimen/spacing_medium"
            android:src="@drawable/ic_edit"
            app:tint="@color/icon_tint" />

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_message_input"
            android:gravity="center_vertical"
            android:hint="@string/chat_message_hint"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="5"
            android:minHeight="@dimen/touch_target"
            android:paddingStart="@dimen/spacing_medium"
            android:paddingTop="@dimen/spacing_small"
            android:paddingEnd="@dimen/spacing_medium"
            android:paddingBottom="@dimen/spacing_small"
            android:textAppearance="@style/TextAppearance.Telefarm.ItemTitle"
            android:textColorHint="@color/text_secondary" />

        <ImageView
            android:id="@+id/micButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_marginStart="@dimen/spacing_small"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_record_voice"
            android:padding="@dimen/spacing_medium"
            android:src="@drawable/ic_mic"
            app:tint="@color/icon_tint" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sendButton"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:contentDescription="@string/cd_send_message"
                app:icon="@drawable/ic_send"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/sendProgress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/text_on_accent"
                app:indicatorSize="24dp"
                app:trackThickness="2dp" />

        </FrameLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/cannotSendBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/warning_background"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/spacing_small"
        android:text="@string/chat_cannot_send"
        android:textAppearance="@style/TextAppearance.Telefarm.ItemSubtitle"
        android:visibility="gone" />

</LinearLayout>
