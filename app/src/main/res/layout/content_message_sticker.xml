<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/message_sticker_size"
    android:layout_height="@dimen/message_sticker_size">

    <ImageView
        android:id="@+id/stickerImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/message_sticker"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/stickerPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/message_animated_sticker"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

</FrameLayout>
